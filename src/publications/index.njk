---
layout: base.njk
title: Publications
description: Publications and links, sourced from bibliography.json.
---
{% from "partials/project-pills.njk" import pills %}
{% from "partials/pub-icons.njk" import iconPublisher, iconDoi, iconPdf, iconSlides, iconPoster %}

<h1>Publications</h1>
<p class="lede-small">Source of truth: <code>src/_data/bibliography.json</code>. Download generated BibTeX: <a href="{{ '/publications.bib' | url }}"><code>publications.bib</code></a>.</p>

<ol class="pub-list">
  {% for pub in publications %}
  {% set primary = pub | pubPrimaryLink %}
  <li class="pub-item" id="{{ pub.id }}">
    <div class="pub-item-row">
      {% if pub.thumb %}
      {% if primary %}
      <a class="pub-thumb" href="{{ primary }}">
        <img src="{% if pub.thumb | isAbsoluteUrl %}{{ pub.thumb }}{% else %}{{ pub.thumb | url }}{% endif %}" width="120" height="160" loading="lazy" alt="">
      </a>
      {% else %}
      <div class="pub-thumb">
        <img src="{% if pub.thumb | isAbsoluteUrl %}{{ pub.thumb }}{% else %}{{ pub.thumb | url }}{% endif %}" width="120" height="160" loading="lazy" alt="">
      </div>
      {% endif %}
      {% endif %}
      <div class="pub-item-body">
        <p class="pub-authors">{{ pub.author | formatAuthors }}</p>
        <p class="pub-title">{% if pub.titleHtml %}{{ pub.titleHtml | safe }}{% else %}{{ pub.title }}{% endif %}</p>
        <p class="pub-venue">
          {% set y = pub.issued | pubYear %}
          {% if y %}{{ y }}. {% endif %}
          {{ pub | pubVenue }}
          {% if pub.volume %}<span class="vol">, vol. {{ pub.volume }}</span>{% endif %}
          {% if pub.issue %}<span class="iss">, no. {{ pub.issue }}</span>{% endif %}
          {% if pub.page %}<span class="pp">, pp. {{ pub.page }}</span>{% endif %}
        </p>
        {% if pub.core or pub.scimago %}
        <p class="pub-ranks" aria-label="Venue rankings">
          {% if pub.core %}<span class="venue-badge core" title="CORE">CORE {{ pub.core }}</span>{% endif %}
          {% if pub.scimago %}<span class="venue-badge scimago" title="Scimago Journal Rank">SJR {{ pub.scimago }}</span>{% endif %}
        </p>
        {% endif %}
        <div class="pub-links" aria-label="Publication links">
          {% if pub.URL %}
          <a class="pub-link" href="{{ pub.URL }}"><span class="pub-link-ico" aria-hidden="true">{{ iconPublisher() }}</span><span>Publisher</span></a>
          {% endif %}
          {% if pub.DOI %}
          <a class="pub-link" href="{{ pub.DOI | doiUrl }}"><span class="pub-link-ico" aria-hidden="true">{{ iconDoi() }}</span><span>DOI</span></a>
          {% endif %}
          {% for url in pub.bibLinks.pdf %}
          <a class="pub-link" href="{{ url }}" title="{{ url }}"><span class="pub-link-ico" aria-hidden="true">{{ iconPdf() }}</span><span>{{ url | bibLinkLabel('pdf', loop.index, pub.bibLinks.pdf.length) }}</span></a>
          {% endfor %}
          {% for url in pub.bibLinks.slides %}
          <a class="pub-link" href="{{ url }}" title="{{ url }}"><span class="pub-link-ico" aria-hidden="true">{{ iconSlides() }}</span><span>{{ url | bibLinkLabel('slides', loop.index, pub.bibLinks.slides.length) }}</span></a>
          {% endfor %}
          {% for url in pub.bibLinks.poster %}
          <a class="pub-link" href="{{ url }}" title="{{ url }}"><span class="pub-link-ico" aria-hidden="true">{{ iconPoster() }}</span><span>{{ url | bibLinkLabel('poster', loop.index, pub.bibLinks.poster.length) }}</span></a>
          {% endfor %}
        </div>
        {% if pub.linkedResources.software.length or pub.linkedResources.datasets.length or pub.linkedResources.models.length %}
        <p class="small muted">
          Related resources:
          {% for r in pub.linkedResources.software %}
          <a href="{{ r.url }}"{{ r.url | externalLinkAttrs }}>Software{% if pub.linkedResources.software.length > 1 %} {{ loop.index }}{% endif %}</a>{% if not loop.last or pub.linkedResources.datasets.length or pub.linkedResources.models.length %} · {% endif %}
          {% endfor %}
          {% for r in pub.linkedResources.datasets %}
          <a href="{{ r.url }}"{{ r.url | externalLinkAttrs }}>Dataset{% if pub.linkedResources.datasets.length > 1 %} {{ loop.index }}{% endif %}</a>{% if not loop.last or pub.linkedResources.models.length %} · {% endif %}
          {% endfor %}
          {% for r in pub.linkedResources.models %}
          <a href="{{ r.url }}"{{ r.url | externalLinkAttrs }}>Model{% if pub.linkedResources.models.length > 1 %} {{ loop.index }}{% endif %}</a>{% if not loop.last %} · {% endif %}
          {% endfor %}
          (<a href="{{ '/resources/' | url }}">all resources</a>)
        </p>
        {% endif %}
        {% if pub.bibtex %}
        <details class="pub-cite">
          <summary>Cite (BibTeX)</summary>
          <pre>{{ pub.bibtex }}</pre>
        </details>
        {% endif %}
        {{ pills(pub.projectIds, projects) }}
      </div>
    </div>
  </li>
  {% endfor %}
</ol>
