---
layout: base.njk
title: Resources
description: Software, datasets, and models with links to projects.
---
{% from "partials/project-pills.njk" import pills %}

<h1>Resources</h1>
<p class="lede-small">Software, datasets, and models we release or maintain. Each entry can include an optional <code>image</code> (path under <code>/assets/images/</code> or absolute URL). Use <code>projectIds</code> for cross-links.</p>

<nav class="page-jump-nav" aria-label="Resource sections">
  <span class="page-jump-label">Jump to</span>
  <a href="#software">Software</a>
  <a href="#datasets">Datasets</a>
  <a href="#models">Models</a>
</nav>

<section class="artifact-section" id="software">
  <h2>Software</h2>
  <ul class="artifact-list">
    {% for sw in software %}
    <li class="artifact-item" id="software-{{ sw.id }}">
      <div class="artifact-row">
        {% if sw.image %}
        <figure class="artifact-figure">
          <img src="{% if sw.image | isAbsoluteUrl %}{{ sw.image }}{% else %}{{ sw.image | url }}{% endif %}" width="200" height="112" loading="lazy" alt="">
        </figure>
        {% endif %}
        <div class="artifact-body">
          <h3><a href="{{ sw.url }}"{{ sw.url | externalLinkAttrs }}>{{ sw.name }}</a></h3>
          <p>{{ sw.description }}</p>
          <div class="artifact-meta">{{ pills(sw.projectIds, projects) }}</div>
        </div>
      </div>
    </li>
    {% endfor %}
  </ul>
</section>

