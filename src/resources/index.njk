---
layout: base.njk
title: Resources
description: Software, datasets, and models with links to projects.
---
{% from "partials/project-pills.njk" import pills %}

<h1>Resources</h1>
<p class="lede-small">Software, datasets, and models we release or maintain. Canonical source: <code>src/_data/resources.json</code>. Each entry can include optional <code>authors</code>, <code>projectIds</code>, and <code>publicationIds</code> for automatic cross-linking.</p>

<nav class="page-jump-nav" aria-label="Resource sections">
  <span class="page-jump-label">Jump to</span>
  <a href="#software">Software</a>
  <a href="#datasets">Datasets</a>
  <a href="#models">Models</a>
</nav>

<section class="artifact-section" id="software">
  <h2>Software</h2>
  <ul class="artifact-list">
    {% for sw in resourceCatalog.software %}
    <li class="artifact-item" id="software-{{ sw.id }}">
      <div class="artifact-row">
        {% if sw.image %}
        <figure class="artifact-figure">
          <img src="{% if sw.image | isAbsoluteUrl %}{{ sw.image }}{% else %}{{ sw.image | url }}{% endif %}" width="200" height="112" loading="lazy" alt="">
        </figure>
        {% endif %}
        <div class="artifact-body">
          <h3><a href="{{ sw.url }}"{{ sw.url | externalLinkAttrs }}>{{ sw.name }}</a></h3>
          <p>{{ sw.description }}</p>
          {% if sw.authors.length %}<p class="small muted">Authors: {{ sw.authors | join(", ") }}</p>{% endif %}
          {% if sw.linkedPublications.length %}
          <p class="small muted">Related publications:
            {% for pub in sw.linkedPublications %}
            <a href="{{ '/publications/' | url }}#{{ pub.id }}">{{ pub.title }}</a>{% if not loop.last %} · {% endif %}
            {% endfor %}
          </p>
          {% endif %}
          <div class="artifact-meta">{{ pills(sw.projectIds, projects) }}</div>
        </div>
      </div>
    </li>
    {% endfor %}
    {% if not resourceCatalog.software.length %}
    <li class="muted">No software resources listed.</li>
    {% endif %}
  </ul>
</section>

